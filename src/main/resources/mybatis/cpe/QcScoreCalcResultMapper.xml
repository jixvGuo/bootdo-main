<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  QC评分计算汇总结果 Mapper
  对应表：ass_qc_score_calc_result
  存储每个项目在某评分阶段的平均分计算汇总；唯一键 (task_id, pro_id, phase)，支持幂等 upsert
-->
<mapper namespace="com.bootdo.cpe.dao.QcScoreCalcResultDao">

    <select id="get" resultType="com.bootdo.cpe.domain.QcScoreCalcResultDO">
        select `id`,`task_id`,`pro_id`,`phase`,`avg_score`,`valid_count`,`used_count`,`created`,`created_by`,`deleted`
        from ass_qc_score_calc_result where id = #{value}
    </select>

    <select id="list" resultType="com.bootdo.cpe.domain.QcScoreCalcResultDO">
        select `id`,`task_id`,`pro_id`,`phase`,`avg_score`,`valid_count`,`used_count`,`created`,`created_by`,`deleted`
        from ass_qc_score_calc_result
        <where>
            <if test="id != null and id != ''"> and id = #{id} </if>
            <if test="taskId != null and taskId != ''"> and task_id = #{taskId} </if>
            <if test="proId != null and proId != ''"> and pro_id = #{proId} </if>
            <if test="phase != null and phase != ''"> and phase = #{phase} </if>
            <if test="deleted != null and deleted != ''"> and deleted = #{deleted} </if>
        </where>
        order by id desc
        <if test="offset != null and limit != null">
            limit #{offset}, #{limit}
        </if>
    </select>

    <select id="count" resultType="int">
        select count(*) from ass_qc_score_calc_result
        <where>
            <if test="taskId != null and taskId != ''"> and task_id = #{taskId} </if>
            <if test="proId != null and proId != ''"> and pro_id = #{proId} </if>
            <if test="phase != null and phase != ''"> and phase = #{phase} </if>
            <if test="deleted != null and deleted != ''"> and deleted = #{deleted} </if>
        </where>
    </select>

    <insert id="save" parameterType="com.bootdo.cpe.domain.QcScoreCalcResultDO" useGeneratedKeys="true" keyProperty="id">
        insert into ass_qc_score_calc_result
        (
            `task_id`,
            `pro_id`,
            `phase`,
            `avg_score`,
            `valid_count`,
            `used_count`,
            `created_by`,
            `deleted`,
            `created`
        )
        values
        (
            #{taskId},
            #{proId},
            #{phase},
            #{avgScore},
            #{validCount},
            #{usedCount},
            #{createdBy},
            0,
            now()
        )
    </insert>

    <!-- UPSERT: 唯一键 (task_id, pro_id, phase) 存在则更新，不存在则插入 -->
    <insert id="upsert" parameterType="com.bootdo.cpe.domain.QcScoreCalcResultDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ass_qc_score_calc_result
        (`task_id`, `pro_id`, `phase`, `avg_score`, `valid_count`, `used_count`, `created_by`, `deleted`, `created`)
        VALUES
        (#{taskId}, #{proId}, #{phase}, #{avgScore}, #{validCount}, #{usedCount}, #{createdBy}, 0, now())
        ON DUPLICATE KEY UPDATE
            `avg_score`   = VALUES(`avg_score`),
            `valid_count` = VALUES(`valid_count`),
            `used_count`  = VALUES(`used_count`),
            `created_by`  = VALUES(`created_by`),
            `created`     = now()
    </insert>

    <update id="update" parameterType="com.bootdo.cpe.domain.QcScoreCalcResultDO">
        update ass_qc_score_calc_result
        <set>
            <if test="taskId != null"> `task_id` = #{taskId}, </if>
            <if test="proId != null"> `pro_id` = #{proId}, </if>
            <if test="phase != null"> `phase` = #{phase}, </if>
            <if test="avgScore != null"> `avg_score` = #{avgScore}, </if>
            <if test="validCount != null"> `valid_count` = #{validCount}, </if>
            <if test="usedCount != null"> `used_count` = #{usedCount}, </if>
            <if test="createdBy != null"> `created_by` = #{createdBy}, </if>
            <if test="deleted != null"> `deleted` = #{deleted}, </if>
            <if test="created != null"> `created` = #{created}, </if>
        </set>
        where id = #{id}
    </update>

    <delete id="remove">
        delete from ass_qc_score_calc_result where id = #{value}
    </delete>

    <delete id="batchRemove">
        delete from ass_qc_score_calc_result where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
